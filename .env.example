# === Lumio — Configuration ===
# Copier ce fichier en .env et renseigner les valeurs.

# --- Base de données ---
POSTGRES_USER=lumio
POSTGRES_PASSWORD=changeme_pg_password
POSTGRES_DB=lumio
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# URL synchrone pour Alembic
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- Sécurité ---
SESSION_SECRET=changeme_session_secret_at_least_32_chars

# --- Mistral AI ---
MISTRAL_API_KEY=
MISTRAL_TUTOR_MODEL=mistral-small-latest
MISTRAL_MEDIUM_MODEL=mistral-medium-latest
MISTRAL_GUARD_MODEL=mistral-small-latest
MISTRAL_MODERATION_MODEL=mistral-moderation-latest

# --- Ports (boucle locale uniquement) ---
FRONTEND_PORT=3100
BACKEND_PORT=8100

# --- URL publique ---
PUBLIC_URL=https://lumio.wezon.fr

# --- Rétention ---
CONVERSATION_RETENTION_DAYS=365

# --- Fuseau horaire ---
TZ=Europe/Paris

# --- Supports visuels (prototype « feuille de Lumio », voir docs/VISUAL_AIDS.md) ---
# Désactivé par défaut. Il faut AUSSI activer « Supports visuels » sur chaque profil.
VISUAL_AIDS_ENABLED=false
